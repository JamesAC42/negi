{
  "name": "@music-os/desktop",
  "productName": "negi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build && vite build --config vite.main.config.ts && vite build --config vite.main.config.ts --mode preload",
    "build:electron": "vite build --config vite.main.config.ts && vite build --config vite.main.config.ts --mode preload",
    "discovery-candidates:smoke": "tsx src/scripts/discovery-candidates-smoke.ts",
    "electron-health:smoke": "tsx src/scripts/electron-health-smoke.tsx",
    "playback-progress:smoke": "tsx src/scripts/playback-progress-smoke.ts",
    "appearance:smoke": "tsx src/scripts/appearance-smoke.ts",
    "typecheck": "tsc --noEmit",
    "artwork-requests:smoke": "tsx src/scripts/artwork-requests-smoke.ts",
    "artist-resource:smoke": "tsx src/scripts/artist-resource-smoke.ts",
    "record-player:smoke": "tsx src/scripts/record-player-smoke.ts",
    "record-player-sleeve:smoke": "node src/scripts/record-player-sleeve-smoke.mjs",
    "now-playing-motion:smoke": "node src/scripts/now-playing-motion-smoke.mjs",
    "visualizer-canvas:smoke": "node src/scripts/visualizer-canvas-smoke.mjs",
    "turntable-cache:smoke": "node src/scripts/turntable-cache-smoke.mjs",
    "lyrics:smoke": "tsx src/scripts/lyrics-smoke.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource-variable/syne": "^5.3.0",
    "@music-os/core": "0.1.0",
    "electron": "^31.7.0",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.0",
    "zod": "^3.25.46"
  },
  "devDependencies": {
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  }
}
